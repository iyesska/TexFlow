# URL pública de la aplicación, para los metadatos.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base de datos PostgreSQL donde viven las cuentas, los documentos y sus imágenes.
# Crea la base de datos y aplica las migraciones con `pnpm db:deploy`.
DATABASE_URL="postgresql://texflow:texflow@127.0.0.1:5432/texflow"

# Firma las sesiones. Obligatorio: al menos 32 caracteres aleatorios. Genera uno con
#   openssl rand -base64 32
AUTH_SECRET=""

# La dirección con la que se entra a la aplicación. En desarrollo no hace falta. En
# producción, define AUTH_URL o, detrás de un proxy que ya fija la cabecera Host,
# AUTH_TRUST_HOST="true".
# AUTH_URL="https://texflow.example.com"
# AUTH_TRUST_HOST="true"

# Inicio de sesión con GitHub, opcional: se ofrece solo si están las dos variables.
# Crea una OAuth App en GitHub con la URL de retorno <AUTH_URL>/api/auth/callback/github.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Ejecutable de Pandoc. Un nombre se busca en /usr/local/bin, /usr/bin y /bin;
# también puede ser una ruta absoluta.
PANDOC_PATH="pandoc"

# Ejecutable de Tectonic, el motor LaTeX. Se resuelve igual que PANDOC_PATH.
TECTONIC_PATH="tectonic"

# Caché de paquetes LaTeX que llena scripts/setup-tectonic.sh. Los documentos se
# compilan sin red, así que todo lo que necesiten debe estar aquí de antemano.
TECTONIC_CACHE_DIR="/var/cache/texflow/tectonic"

# Aislamiento del proceso de LaTeX con bubblewrap.
#   required: sin aislamiento, la compilación a PDF se niega a ejecutarse.
#   disabled: compila sin aislar. Un documento puede entonces leer archivos del
#             servidor. Úsalo solo en tu propia máquina y con tus propios documentos.
SANDBOX_ISOLATION="required"

# Bases de datos de las pruebas, distintas de la de desarrollo: las pruebas crean y
# borran cuentas. Estos son los valores por defecto.
# TEST_DATABASE_URL="postgresql://texflow:texflow@127.0.0.1:5432/texflow_test"
# E2E_DATABASE_URL="postgresql://texflow:texflow@127.0.0.1:5432/texflow_e2e"
