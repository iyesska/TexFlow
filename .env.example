# URL pública de la aplicación. Se usa para los metadatos y, desde la fase 7, para Auth.js.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ejecutable de Pandoc. Un nombre se busca en /usr/local/bin, /usr/bin y /bin;
# también puede ser una ruta absoluta.
PANDOC_PATH="pandoc"

# Ejecutable de Tectonic, el motor LaTeX. Se resuelve igual que PANDOC_PATH.
TECTONIC_PATH="tectonic"

# Caché de paquetes LaTeX que llena scripts/setup-tectonic.sh. Los documentos se
# compilan sin red, así que todo lo que necesiten debe estar aquí de antemano.
TECTONIC_CACHE_DIR="/var/cache/texflow/tectonic"

# Aislamiento del proceso de LaTeX con bubblewrap.
#   required: sin aislamiento, la compilación a PDF se niega a ejecutarse.
#   disabled: compila sin aislar. Un documento puede entonces leer archivos del
#             servidor. Úsalo solo en tu propia máquina y con tus propios documentos.
SANDBOX_ISOLATION="required"
